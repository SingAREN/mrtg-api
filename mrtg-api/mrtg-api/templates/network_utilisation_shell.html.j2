<!DOCTYPE HTML>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<!--[if IE]><meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'><![endif]-->
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=2, shrink-to-fit=no, user-scalable=yes">
<title>SingAREN :: Members' Statistics &ndash; Network Usage</title>
<link rel="icon" type="/image/x-icon" href="favicon.ico">
<link rel="stylesheet" type="text/css" href="/static/css/plugins.css">
<link rel="stylesheet" type="text/css" href="/static/css/cd-timeliner.css">
<link rel="stylesheet" type="text/css" href="/static/css/style.css">
<!--[if (gte IE 6)&(lte IE 8)]>
	<script src="/static/js/selectivizr.js"></script>
<![endif]-->
<!--[if lt IE 9]>
	<script src="/static/js/html5shiv.min.js"></script>
    <script src="/static/js/respond.min.js"></script>
	<script src="/static/js/IE9.js"></script>
<![endif]-->
</head>
<body class="">
	<div id="wrapper">
		<div class="main-container">
			<div class="container clearfix">
				<h3>{{ title }}</h3>
				<p>The statistics were last updated <strong>{{ last_update }}</strong></p>
				<div class="nug-container">
					<h5><span>'Daily' Graph (5 Minute Average)</span></h5>
					<div class="row">
						<div class="col-lg-6">
							<div class="graph-img"><img src="{{ day.img }}" alt=""></div>
						</div>
						<div class="col-lg-6">
							<div class="table-responsive">
								<table class="table table-striped table-bordered text-center">
									<thead class="thead-dark">
										<tr>
											<th class="nobg"></th>
											<th>Max</th>
											<th>Average</th>
											<th>Current</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td><strong>In</strong></td>
											<td>{{ day.in.max }}</td>
											<td>{{ day.in.average }}</td>
											<td>{{ day.in.current }}</td>
										</tr>
										<tr>
											<td><strong>Out</strong></td>
											<td>{{ day.out.max }}</td>
											<td>{{ day.out.average }}</td>
											<td>{{ day.out.current }}</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<div class="nug-container">
					<h5><span>'Weekly' Graph (30 Minute Average)</span></h5>
					<div class="row">
						<div class="col-lg-6">
							<div class="graph-img"><img src="{{ week.img }}" alt=""></div>
						</div>
						<div class="col-lg-6">
							<div class="table-responsive">
								<table class="table table-striped table-bordered text-center">
									<thead class="thead-dark">
										<tr>
											<th class="nobg"></th>
											<th>Max</th>
											<th>Average</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td><strong>In</strong></td>
											<td>{{ week.in.max }}</td>
											<td>{{ week.in.average }}</td>
										</tr>
										<tr>
											<td><strong>Out</strong></td>
											<td>{{ week.out.max }}</td>
											<td>{{ week.out.average }}</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<div class="nug-container">
					<h5><span>'Monthly' Graph (2 Hour Average)</span></h5>
					<div class="row">
						<div class="col-lg-6">
							<div class="graph-img"><img src="{{ month.img }}" alt=""></div>
						</div>
						<div class="col-lg-6">
							<div class="table-responsive">
								<table class="table table-striped table-bordered text-center">
									<thead class="thead-dark">
										<tr>
											<th class="nobg"></th>
											<th>Max</th>
											<th>Average</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td><strong>In</strong></td>
											<td>{{ month.in.max }}</td>
											<td>{{ month.in.average }}</td>
										</tr>
										<tr>
											<td><strong>Out</strong></td>
											<td>{{ month.out.max }}</td>
											<td>{{ month.out.average }}</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<div class="nug-container">
					<h5><span>'Yearly' Graph (1 Day Average)</span></h5>
					<div class="row">
						<div class="col-lg-6">
							<div class="graph-img"><img src="{{ year.img }}" alt=""></div>
						</div>
						<div class="col-lg-6">
							<div class="table-responsive">
								<table class="table table-striped table-bordered text-center">
									<thead class="thead-dark">
										<tr>
											<th class="nobg"></th>
											<th>Max</th>
											<th>Average</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td><strong>In</strong></td>
											<td>{{ year.in.max }}</td>
											<td>{{ year.in.average }}</td>
										</tr>
										<tr>
											<td><strong>Out</strong></td>
											<td>{{ year.out.max }}</td>
											<td>{{ year.out.average }}</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<div class="graphStyle"><span class="green">GREEN ###</span> Incoming Traffic in Bits per Second</div>
				<div class="graphStyle"><span class="blue">BLUE ###</span> Outgoing Traffic in Bits per Second</div>
			</div>
		</div>
		<div class="clear"></div>
    </div>

    <!-- jQuery (necessary JavaScript plugins) -->
    <script src="/static/js/plugin.min.js"></script>
	<script src="/static/js/main-script.js"></script>
</body>
</html>
